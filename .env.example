# Copy to .env on each machine and fill in. Never commit .env.

# LLMs
ANTHROPIC_API_KEY=
COACH_MODEL=claude-sonnet-5-5
ROUTER_MODEL=claude-haiku-4-5-20251001   # intent classification only, if evals show no quality loss
OPENAI_API_KEY=         # eval baseline only (needed from Day 7)
BASELINE_MODEL=         # e.g. a current GPT model ID

# Engine
STOCKFISH_PATH=/usr/local/bin/stockfish
ENGINE_DEFAULT_DEPTH=14

# Database
DATABASE_URL=postgresql://chess:chess@localhost:5432/chesscoach

# Chess.com / Lichess sync
CHESSCOM_USERNAME=
CHESSCOM_USER_AGENT="ai-chess-coach (contact: your-email@example.com)"
LICHESS_USERNAME=
CASE_STUDY_TIME_CONTROLS=600,900+10

# Budget guard (INR per month)
MONTHLY_BUDGET_INR=10000
